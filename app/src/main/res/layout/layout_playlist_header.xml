<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/playlistCoverImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_no_dowload_album_312x312"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CoverImage" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/playlistNameText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:fontFamily="@font/ys_display_medium"
        android:maxLines="2"
        android:textSize="19sp"
        android:textAllCaps="false"
        android:textColor="@color/YP_Black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playlistCoverImage"
        tools:text="Playlist name" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/playlistDescriptionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:fontFamily="@font/ys_display_regular"
        android:textSize="14sp"
        android:textAllCaps="false"
        android:textColor="@color/YP_Black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playlistNameText"
        tools:text="2022" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/playlistDurationText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/ys_display_regular"
        android:textSize="12sp"
        android:textAllCaps="false"
        android:textColor="@color/YP_Black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playlistDescriptionText"
        tools:text="12 минут" />

    <ImageView
        android:id="@+id/separatorPoint"
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_separator_point"
        app:layout_constraintBottom_toBottomOf="@id/playlistDurationText"
        app:layout_constraintStart_toEndOf="@id/playlistDurationText"
        app:layout_constraintTop_toTopOf="@id/playlistDurationText" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/playlistTracksCountText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/ys_display_regular"
        android:textSize="12sp"
        android:textAllCaps="false"
        android:textColor="@color/YP_Black"
        app:layout_constraintBottom_toBottomOf="@id/playlistDurationText"
        app:layout_constraintStart_toEndOf="@id/separatorPoint"
        app:layout_constraintTop_toTopOf="@id/playlistDurationText"
        tools:text="12 треков" />

</androidx.constraintlayout.widget.ConstraintLayout>