<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yp_light_gray">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/playlistScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Шапка плейлиста: обложка, название, описание, продолжительность, количество треков -->
            <include
                android:id="@+id/playlistHeader"
                layout="@layout/layout_playlist_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Кнопка Поделиться -->
            <ImageButton
                android:id="@+id/shareButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/share"
                android:src="@drawable/ic_button_share"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/playlistHeader"
                app:tint="@color/YP_Black" />

            <!-- Кнопка Меню (три точки) -->
            <ImageButton
                android:id="@+id/menuButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/menu"
                android:src="@drawable/ic_three_dots"
                app:layout_constraintBottom_toBottomOf="@id/shareButton"
                app:layout_constraintStart_toEndOf="@id/shareButton"
                app:layout_constraintTop_toTopOf="@id/shareButton"
                app:tint="@color/YP_Black"/>

            <!-- Отступ снизу, чтобы свёрнутый BottomSheet не перекрывал кнопки -->
            <Space
                android:id="@+id/bottomSpacer"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                app:layout_constraintTop_toBottomOf="@id/shareButton" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Кнопка "Назад" поверх контента -->
    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/back"
        android:src="@drawable/ic_arrow_back" />

    <!-- затемнение контента при открытом меню плейлиста -->
        <View
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone" />

    <!-- BottomSheet со списком треков плейлиста -->
    <LinearLayout
        android:id="@+id/playlistTracksBottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/BottomSheetStyle"
        android:orientation="vertical"
        android:paddingBottom="24dp"
        app:behavior_hideable="false"
        app:behavior_peekHeight="302dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <!-- Индикатор для перетаскивания -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bottom_sheet_handle" />

        <!-- Список треков плейлиста -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playlistTracksRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            tools:listitem="@layout/item_track" />

    </LinearLayout>

    <!-- Bottom Sheet меню плейлиста (поверх всего, скрыт по умолчанию) -->
    <include
        android:id="@+id/playlistMenuBottomSheet"
        layout="@layout/layout_playlist_menu_bottom_sheet" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>