<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    style="@style/ActivityScreenMain.Background.Setting"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="top"
    android:orientation="vertical"
    tools:context=".presentation.ui.search.SearchActivity">

    <!-- Название экрана поиск -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back_button"
            style="@style/DarkLightIcon"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_arrow_back" />

        <com.google.android.material.textview.MaterialTextView
            style="@style/ActivitySearchHead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/textSearch" />
    </LinearLayout>

    <!-- Поле ввода Поиск -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/search_field"
            style="@style/SearchEditTextStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_background"
            android:drawableStart="@drawable/ic_button_search"
            android:drawablePadding="12dp"
            android:gravity="center_vertical"
            android:hint="@string/textSearch"
            android:inputType="text"
            android:maxLength="15"
            android:paddingVertical="12dp"
            android:paddingStart="12dp"
            android:paddingEnd="48dp"
            android:textCursorDrawable="@drawable/search_urs"
            android:imeOptions="actionDone"
            android:singleLine="true"
            tools:text="Nirvana Smells" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/clearIcon"
            style="@style/ClearIconStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_button_clear"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Прогресс-бар загрузки -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="83dp"
        android:indeterminateTint="@color/blue_cornflower"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Фокус на поле ввода - Хинт -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/searchHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:textAlignment="center"
        android:text="@string/search_hint"
        android:visibility="gone"
        tools:visibility="visible"/>

    <!-- История поиска -->
    <LinearLayout
        android:id="@+id/search_history_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Заголовок "Вы искали" -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/history_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="@string/you_searched"
            android:textSize="19sp"
            android:fontFamily="@font/ys_display_medium"
            android:textColor="@color/YP_Black" />

        <!-- RecyclerView для истории треков -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/history_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp" />

        <!-- Кнопка "Очистить историю" -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/clear_history_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:text="@string/clear_history"
            style="@style/UpdateButtonStyle" />
    </LinearLayout>

    <!-- RecyclerView для списка треков -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        tools:listitem="@layout/item_track" />

    <!-- Заглушка - Проблемы со связью-->
    <LinearLayout
        android:id="@+id/placeholder_search"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/placeholder_image"
            style="@style/ImageStubStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/placeholder_text"
            style="@style/TextStubStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/problem_internet"
            android:textAlignment="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/update_button"
            style="@style/UpdateButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/update" />

    </LinearLayout>

    <!-- Заглушка - Ничего не нашлось-->
    <LinearLayout
        android:id="@+id/stub_no_result"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/image_no_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/ImageStubStyleNoResult"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/text_no_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_result"
            style="@style/TextStubStyle"
            />
    </LinearLayout>

</LinearLayout>