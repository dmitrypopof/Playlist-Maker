<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    style="@style/ActivityScreenMain.Background.Setting"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="top"
    android:orientation="vertical"
    tools:context=".SearchActivity">

    <!-- Название экрана поиск -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back_button"
            style="@style/DarkLightIcon"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_arrow_back" />

        <com.google.android.material.textview.MaterialTextView
            style="@style/ActivitySearchHead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/textSearch" />
    </LinearLayout>

    <!-- Поле ввода Поиск -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/search_field"
            style="@style/SearchEditTextStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_background"
            android:drawableStart="@drawable/ic_button_search"
            android:drawablePadding="12dp"
            android:gravity="center_vertical"
            android:hint="@string/textSearch"
            android:inputType="text"
            android:maxLength="15"
            android:paddingVertical="12dp"
            android:paddingStart="12dp"
            android:paddingEnd="48dp"
            android:textCursorDrawable="@drawable/search_urs"
            tools:text="dgbdgngnd" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/clearIcon"
            style="@style/ClearIconStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_button_clear"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Контейнеры с треками -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        android:paddingHorizontal="13dp">
        <!-- Обложка-->
        <androidx.cardview.widget.CardView
            android:layout_width="45dp"
            android:layout_height="45dp"
            app:cardCornerRadius="2dp"
            app:cardElevation="0dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

        </androidx.cardview.widget.CardView>

        <!-- Контейнер для текстовой информации (название и исполнитель/длительность) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">

            <!-- Название трека -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/track_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yesterday"
                android:textColor="@color/YP_Black"
                android:fontFamily="@font/ys_display_regular"
                android:textSize="16sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <!-- Исполнитель и длительность в одной строке -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="1dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/artist_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="The Beatles"
                    android:fontFamily="@font/ys_display_regular"
                    android:textSize="11sp"
                    android:textColor="@color/YP_Text_Gray"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="•"
                    android:textColor="@color/YP_Text_Gray"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/track_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2:55"
                    android:textSize="11sp"
                    android:textColor="@color/YP_Text_Gray"
                     />
            </LinearLayout>
        </LinearLayout>

        <!-- Иконка стрелки вправо -->
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_button_arrow_forward"
            app:tint="@color/YP_Text_Gray"
            android:paddingHorizontal="12dp"/>
    </LinearLayout>




</LinearLayout>