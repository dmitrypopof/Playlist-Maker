<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/audioPlayer">

    <!-- Левая направляющая с отступом 4dp -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/left_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="4dp" />

    <!-- Правая направляющая с отступом 4dp -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/right_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="4dp" />

    <!-- Левая направляющая для кнопок с отступом 24dp -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/left_buttons_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="24dp" />

    <!-- Правая направляющая для кнопок с отступом 24dp -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/right_buttons_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="24dp" />

    <!-- Кнопка назад -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/back_button"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        app:icon="@drawable/ic_arrow_back"
        style="@style/DarkLightIcon"
        app:layout_constraintStart_toStartOf="@id/left_guideline"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- Обложка альбома -->
    <androidx.cardview.widget.CardView
        android:id="@+id/album_cover"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="2dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0"
        android:layout_marginTop="82dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/image"
            android:layout_width="312dp"
            android:layout_height="312dp"
            android:scaleType="centerCrop"
            tools:src="@drawable/ic_no_dowload_album_312x312"
            style="@style/TrackImageStyle" />
    </androidx.cardview.widget.CardView>

    <!-- Имя трека -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/track_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Player_TrackNameStyle"
        tools:text="Smells Like Teen Spirit"
        app:layout_constraintTop_toBottomOf="@id/album_cover"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="@id/album_cover" />

    <!-- Имя артиста -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/artist_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Player_ArtistNameStyle"
        tools:text="Nirvana"
        app:layout_constraintTop_toBottomOf="@id/track_name"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="@id/track_name"/>

    <!-- Кнопка "Добавить в плейлист" -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/addPlaylist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:icon="@drawable/ic_add_playlist_button"
        style="@style/ButtonAudioPlaylist"
        app:layout_constraintTop_toBottomOf="@id/artist_name"
        app:layout_constraintStart_toStartOf="@id/left_buttons_guideline"
        app:layout_constraintBottom_toBottomOf="@id/playButton"
        app:layout_constraintTop_toTopOf="@id/playButton" />

    <!-- Кнопка "Play" -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/playButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:icon="@drawable/ic_play_button"
        style="@style/DarkLightIcon"
        app:layout_constraintTop_toBottomOf="@id/artist_name"
        android:layout_marginTop="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Кнопка "Избранное" -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/favouriteButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:icon="@drawable/ic_favourites_button"
        style="@style/ButtonAudioPlaylist"
        app:layout_constraintTop_toBottomOf="@id/artist_name"
        app:layout_constraintEnd_toEndOf="@id/right_buttons_guideline"
        app:layout_constraintBottom_toBottomOf="@id/playButton"
        app:layout_constraintTop_toTopOf="@id/playButton" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/track_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Player_ArtistNameStyle"
        tools:text="0:30"
        app:layout_constraintTop_toBottomOf="@id/playButton"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="@id/playButton"
        app:layout_constraintEnd_toEndOf="@id/playButton"/>

    <!-- Информация о треке -->
    <GridLayout
        android:id="@+id/track_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="8dp"
        android:columnCount="2"
        android:columnOrderPreserved="false"
        android:rowCount="5"
        app:layout_constraintEnd_toStartOf="@+id/right_buttons_guideline"
        app:layout_constraintStart_toStartOf="@+id/left_buttons_guideline"
        app:layout_constraintTop_toBottomOf="@id/track_time">

        <!-- Продолжительность -->
        <com.google.android.material.textview.MaterialTextView
            style="@style/TrackInfoText"
            android:text="@string/duration_song" />

        <com.google.android.material.textview.MaterialTextView
            style="@style/TrackInfoText.End"
            tools:text="5:35" />

        <!-- Альбом -->
        <com.google.android.material.textview.MaterialTextView
            style="@style/TrackInfoText"
            android:text="@string/album" />

        <com.google.android.material.textview.MaterialTextView
            style="@style/TrackInfoText.End"
            tools:text="Nevermind" />

        <!-- Год -->
        <com.google.android.material.textview.MaterialTextView
            style="@style/TrackInfoText"
            android:text="@string/year"/>

        <com.google.android.material.textview.MaterialTextView
            style="@style/TrackInfoText.End"
            tools:text="1991"/>

        <!-- Жанр -->
        <com.google.android.material.textview.MaterialTextView
            style="@style/TrackInfoText"
            android:text="@string/genre"/>

        <com.google.android.material.textview.MaterialTextView
            style="@style/TrackInfoText.End"
            tools:text="Grunge" />

        <!-- Страна -->
        <com.google.android.material.textview.MaterialTextView
            style="@style/TrackInfoText"
            android:text="@string/country"/>

        <com.google.android.material.textview.MaterialTextView
            style="@style/TrackInfoText.End"
            tools:text="США" />

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>