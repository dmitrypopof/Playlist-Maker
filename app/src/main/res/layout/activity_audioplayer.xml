<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/audioPlayer">

    <!-- Левая направляющая с отступом 4dp -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/left_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="4dp" />

    <!-- Правая направляющая с отступом 4dp -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/right_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="4dp" />

    <!-- Кнопка назад -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/back_button"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        app:icon="@drawable/ic_arrow_back"
        style="@style/DarkLightIcon"
        app:layout_constraintStart_toStartOf="@id/left_guideline"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- Обложка альбома -->
    <androidx.cardview.widget.CardView
        android:id="@+id/album_cover"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="2dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0"
        android:layout_marginTop="82dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/image"
            android:layout_width="312dp"
            android:layout_height="312dp"
            android:scaleType="centerCrop"
            tools:src="@drawable/ic_no_dowload_album_312x312"
            style="@style/TrackImageStyle" />
    </androidx.cardview.widget.CardView>

    <!-- Имя трека -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/track_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ys_display_medium"
        android:textSize="22sp"
        android:textColor="@color/YP_Black"
        tools:text="Smells Like Teen Spirit"
        app:layout_constraintTop_toBottomOf="@id/album_cover"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="@id/album_cover" />

    <!-- Имя артиста -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/artist_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ys_display_medium"
        android:textSize="14sp"
        android:textColor="@color/YP_Black"
        tools:text="Nirvana"
        app:layout_constraintTop_toBottomOf="@id/track_name"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="@id/track_name"/>



</androidx.constraintlayout.widget.ConstraintLayout>