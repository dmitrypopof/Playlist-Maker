<?xml version="1.0" encoding="utf-8"?>
<resources>
<!--    Основной экран:-->
    <style name="ActivityScreenMain.Background">
        <item name="android:background">@color/black_liquorice</item>
    </style>

<!--    Экран Настройки:-->
    <style name="ActivityScreenSetting" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">@font/ys_display_regular</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center_vertical</item>

        <item name="drawableTint">@color/white</item>
    </style>

    <style name="ActivityScreenMain.Background.Setting">
        <item name="android:background">@color/black_liquorice</item>
    </style>

    <style name="ActivityScreenMain.Background.Setting.Toolbar" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:backgroundTint">@color/black_liquorice</item>
        <item name="iconTint">@color/white</item>
        <item name="android:textColor">@color/white</item>
    </style>


    <style name="DarkLightIcon" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:backgroundTint">@color/black_liquorice</item>
        <item name="iconTint">@color/white</item>
    </style>

    <style name="DarkLightSwitch">
        <item name="thumbTint">@color/blue_cornflower</item>
        <item name="trackTint">@color/blue_cornflower_dark</item>
    </style>


    <!--    Экран Поиск:-->
    <style name="ActivitySearchHead" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">22sp</item>
        <item name="fontFamily">@font/ys_display_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="SearchEditTextStyle" parent="Widget.AppCompat.EditText">
        <item name="android:tint">@color/white</item>
        <item name="android:textColorHint">@color/YP_Black</item>
        <item name="android:textColor">@color/YP_Black</item>
        <item name="drawableTint">@color/YP_Black</item>
    </style>
    <style name="ClearIconStyle">
        <item name="tint">@color/YP_Black</item>
    </style>

    <!--    Экран Поиск: Список треков-->
    <!-- Название трека -->
    <!-- Название трека -->
    <style name="TrackNameStyle">
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Детали трека (исполнитель, длительность) -->
    <style name="TrackDetailsStyle">
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <!-- Разделитель "•" -->
    <style name="TrackSeparatorStyle">
        <item name="android:tint">@color/white</item>
        <item name="android:layout_gravity">center_vertical</item>
    </style>
    <!-- Иконка стрелки вправо -->
    <style name="ForwardButtonStyle">
        <item name="tint">@color/white</item>
    </style>

    <!-- Экран заглушки при поиске  -->
        <!--  Заглушка  -->
    <style name="ImageStubStyle">
        <item name="android:src">@drawable/ic_internet_error_dark_mode</item>
        <item name="android:layout_marginTop">102dp</item>
    </style>
        <!-- Текст  -->
    <style name="TextStubStyle">
        <item name="textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">19sp</item>
        <item name="fontFamily">@font/ys_display_medium</item>
        <item name="android:layout_marginTop">16dp</item>
    </style>
        <!-- Кнопка обновить  -->
    <style name="UpdateButtonStyle" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="cornerRadius">54dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/YP_Black</item>
        <item name="fontFamily">@font/ys_display_medium</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="textAllCaps">false</item>
    </style>
    <!-- Заглушка - Ничего не нашлось-->
    <style name="ImageStubStyleNoResult">
        <item name="android:src">@drawable/ic_nothing_was_found_dark_mode</item>
        <item name="android:layout_marginTop">102dp</item>
    </style>
</resources>